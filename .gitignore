# ──────────────────────────────────────────────
#  Medico – Root .gitignore
# ──────────────────────────────────────────────

# ───── Dependencies ─────
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ───── Environment Variables ─────
.env
.env.main
.env.development
.env.*
!.env.example

# ───── Build Outputs & Artifacts ─────
**/dist/
**/build/
**/.next/
**/out/
*.apk
*.ipa
*.app/
*.exe
*.dmg
.claude
# ───── Expo / React Native ─────
mobile/.expo/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/.metro-health-check*
mobile/.kotlin/

# ───── Prisma ─────
backend/.prisma/

# ───── Testing & Logs ─────
**/coverage/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───── OS Files ─────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
local.properties

# ───── IDE / Editor ─────
.vscode/
.idea/
*.swp
*.swo
*~

# ───── Secrets & Certificates ─────
*.pem
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision

# ───── Firebase / GCP Service Configs ─────
**/google-services.json
**/GoogleService-Info.plist
**/serviceAccount*.json
**/firebase-service-account*.json
**/firebase_account_config.json
**/*-vision-key.json
**/*-service-key.json
**/google-vision-key.json

# ───── TypeScript ─────
*.tsbuildinfo
next-env.d.ts

# ───── Vercel ─────
.vercel

# ───── Razorpay Keys ─────
*.csv
rzp-key.csv

# ───── Project Specific Local Files ─────
Oldful PRD.pdf
OLDFUL API FILE.pdf
prd_text.txt
oldful-v1.apk
parse_pdf.js
parse_api_list.js
*.ps1
API_LIST.pdf
RedcliffeLabs API Documentation.pdf
tmp-figma/

# ───── Misc ─────
*.orig.*
.gemini/
./extract
