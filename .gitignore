# ──────────────────────────────────────────────
#  Medico – Root .gitignore
# ──────────────────────────────────────────────

# ───── Dependencies ─────
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ───── Environment Variables ─────
.env
.env.*
!.env.example

# ───── Build Outputs & Artifacts ─────
**/dist/
**/build/
**/.next/
**/out/
*.apk
*.ipa
*.app/
*.exe
*.dmg

# ───── Expo / React Native ─────
mobile/.expo/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/.metro-health-check*
mobile/.kotlin/

# ───── Prisma ─────
backend/.prisma/

# ───── Testing & Logs ─────
**/coverage/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───── OS Files ─────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ───── IDE / Editor ─────
.vscode/
.idea/
*.swp
*.swo
*~

# ───── Secrets & Certificates ─────
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ───── TypeScript ─────
*.tsbuildinfo
next-env.d.ts

# ───── Vercel ─────
.vercel

# ───── Project Specific Local Files ─────
Oldful PRD.pdf
prd_text.txt
oldful-v1.apk
parse_pdf.js
parse_api_list.js
*.ps1
API_LIST.pdf
OLDFUL API FILE.pdf

# ───── Misc ─────
*.orig.*
.gemini/
backend/src/config/google-vision-key.json
backend/src/config/firebase-service-account.json