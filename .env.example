# Google Maps API Key
# Get from: https://console.cloud.google.com/
# Required APIs: Places API, Geocoding API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
MOBILE_APP_URL=exp://localhost:8081

# Redcliffe Labs Configuration
REDCLIFFE_API_BASE_URL=https://apiv3.redcliffelabs.com
REDCLIFFE_API_KEY=your_redcliffe_api_key_here

# Database
DATABASE_URL=your_database_url

# JWT
JWT_SECRET=your_jwt_secret_key

# Other existing env vars...
NODE_ENV=development
PORT=5000
