generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         AdminRole  @default(CITY_ADMIN)
  cityId       String?
  isActive     Boolean    @default(true)
  isStaffProfile Boolean  @default(false)
  lastLoginAt  DateTime?
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  profileImageUrl String?
  documentsJson   Json?
  city         City?      @relation(fields: [cityId], references: [id])
  auditLogs    AuditLog[]
  sessions     AdminSession[]

  @@index([name, email, role, isActive])
  @@map("admins")
}

model City {
  id               String            @id @default(uuid())
  name             String            @unique
  code             String            @unique
  stateCode        String
  isEnabled        Boolean           @default(true)
  isComingSoon     Boolean           @default(false)
  sequence         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  admins           Admin[]
  bookings         Booking[]
  caregivers       Caregiver[]
  notificationLogs NotificationLog[]
  sosAlerts        SOSAlert[]
  users            User[]

  @@map("cities")
}

model User {
  id                    String                 @id @default(uuid())
  uniqueUserId          String                 @unique
  name                  String
  phone                 String                 @unique
  email                 String?
  gender                String?
  dateOfBirth           DateTime?
  profileImageUrl       String?
  preferredLanguage     String                 @default("en")
  healthTag             HealthTag              @default(NORMAL)
  status                UserStatus             @default(ACTIVE)
  cityId                String
  otpCode               String?
  otpExpiresAt          DateTime?
  refreshToken          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  fcmDeviceToken        String?
  emailMarketingEnabled Boolean                @default(false)
  pushEnabled           Boolean                @default(true)
  smsEnabled            Boolean                @default(true)
  whatsappEnabled       Boolean                @default(true)
  addresses             Address[]
  bookings              Booking[]
  emergencyContacts     EmergencyContact[]
  familyMembers         FamilyMember[]
  healthReports         HealthReport[]
  insuranceApps         InsuranceApplication[]
  labOrders             LabOrder[]
  medicalCards          MedicalCard[]
  payments              Payment[]
  productOrders         ProductOrder[]
  savedCards            SavedCard[]
  sosAlerts             SOSAlert[]
  subscriptions         Subscription[]
  upgradeHistory        SubscriptionUpgradeHistory[]
  city                  City                   @relation(fields: [cityId], references: [id])
  waitlistEntries       WaitlistEntry[]
  meetupRegistrations   MeetupRegistration[]
  sessions              UserSession[]

  @@map("users")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home")
  line1        String
  line2        String?
  cityName     String
  state        String
  pincode      String
  landmark     String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // --- Shiprocket exact address fields ---
  fullName     String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  country      String   @default("India")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model FamilyMember {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  relation           String   // Father, Mother, Spouse, Child, Other
  gender             String?
  dateOfBirth        DateTime?
  bloodGroup         String?
  allergies          String?
  chronicConditions  String?
  emergencyNotes     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

model MedicalCard {
  id                 String   @id @default(uuid())
  userId             String
  bloodGroup         String?
  allergies          String[]
  chronicConditions  String[]
  currentMedications String[]
  primaryDoctor      String?
  insuranceInfo      String?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("medical_cards")
}

model HealthReport {
  id              String    @id @default(uuid())
  userId          String
  title           String
  fileUrl         String
  fileType        String
  uploadedBy      String    @default("user")
  category        String?   @default("Other")
  flagSeverity    String?
  flagNote        String?
  reportDate      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ocrFlags        Json?
  ocrHealthTags   String[]  @default([])
  ocrParsedValues Json?
  ocrProcessedAt  DateTime?
  ocrRawText      String?
  ocrStatus       String    @default("pending")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_reports")
}

model Service {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  icon           String?
  tagline        String?
  description    String?
  pricingText    String?
  heroImageUrl   String?
  route          String?
  sortOrder      Int         @default(0)
  isEnabled      Boolean     @default(true)
  serviceType    ServiceType
  formFieldsJson Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  basePrice      Float?
  headline       String?
  subhead        String?
  checkoutGroup  String      @default("D")
  isDynamic      Boolean     @default(false)
  category       String?
  paymentMode    String      @default("INQUIRY")
  bookings       Booking[]

  @@map("services")
}

model Booking {
  id                 String         @id @default(uuid())
  bookingCode        String         @unique
  userId             String
  serviceId          String
  cityId             String
  caregiverId        String?
  scheduledDate      DateTime
  scheduledTime      String?
  addressLine        String?
  latitude           Float?
  longitude          Float?
  symptoms           String[]
  doctorType         String?
  prescriptionUrl    String?
  staffType          String?
  shiftDuration      ShiftDuration?
  startDate          DateTime?
  endDate            DateTime?
  requirements       String[]
  pickupAddress      String?
  dropAddress        String?
  vehicleType        String?
  amount             Float          @default(0)
  status             BookingStatus  @default(PENDING)
  adminNotes         String?
  isEscalated        Boolean        @default(false)
  isSLABreached      Boolean        @default(false)
  slaDeadline        DateTime?
  formDataJson       Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paymentStatus      PaymentStatus  @default(PENDING)
  servicePersonName  String?
  servicePersonNotes String?
  servicePersonPhone String?
  caregiver          Caregiver?     @relation(fields: [caregiverId], references: [id])
  city               City           @relation(fields: [cityId], references: [id])
  service            Service        @relation(fields: [serviceId], references: [id])
  user               User           @relation(fields: [userId], references: [id])
  labOrders          LabOrder[]
  payments           Payment[]

  @@map("bookings")
}

model Caregiver {
  id                 String                @id @default(uuid())
  name               String
  phone              String                @unique
  email              String?
  specialization     String?
  qualification      String?
  profileImageUrl    String?
  documentsJson      Json?
  cityId             String
  policeVerification CaregiverVerification @default(PENDING)
  isAvailable        Boolean               @default(true)
  shiftType          CaregiverShift        @default(FLEXIBLE)
  performanceRating  Float                 @default(0)
  totalBookings      Int                   @default(0)
  salary             Float                 @default(0)
  payoutNotes        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  bookings           Booking[]
  city               City                  @relation(fields: [cityId], references: [id])
  sosAlerts          SOSAlert[]

  @@index([name, phone, specialization, policeVerification, isAvailable])
  @@map("caregivers")
}

model Plan {
  id             String             @id @default(uuid())
  name           String             @unique
  description    String?
  benefits       String?
  quarterlyPrice Float              @default(0)
  biannualPrice  Float              @default(0)
  yearlyPrice    Float              @default(0)
  isVisible      Boolean            @default(true)
  sortOrder      Int                @default(0)
  tierLevel      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  planType       String             @default("CARE")
  maxConcurrent  Int                @default(1)  // max active subs of this planType per user (CARE=4, HOME=2)
  metadata       Json?
  planBenefits      PlanBenefit[]
  billingCycles     PlanBillingCycle[]
  subscriptions     Subscription[]
  oldPlanHistory    SubscriptionUpgradeHistory[] @relation("OldPlan")
  newPlanHistory    SubscriptionUpgradeHistory[] @relation("NewPlan")
  scheduledForSubs  Subscription[]              @relation("ScheduledPlan")

  @@map("plans")
}

model PlanBillingCycle {
  id                 String         @id @default(uuid())
  planId             String
  durationMonths     Int
  price              Float
  discountPercentage Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  plan               Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions      Subscription[]

  @@map("plan_billing_cycles")
}

model PlanBenefit {
  id              String   @id @default(uuid())
  planId          String
  // ─── Structured fields (V2) ───────────────────────────────────────────────
  benefitCode     String   @default("")   // SOS | TELECONSULT | MEDICINE | etc.
  title           String   @default("")   // Human-readable display label
  description     String?                 // Optional subtitle / detail
  usageLimit      Int      @default(0)    // 0 = unlimited; N = N uses per usagePeriod
  usagePeriod     String   @default("MONTH") // MONTH | QUARTER | YEAR
  displayOrder    Int      @default(0)
  // ─── Legacy fields kept for backward compat ───────────────────────────────
  serviceCategory String   @default("")
  freeCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_benefits")
}

model Subscription {
  id                         String              @id @default(uuid())
  userId                     String
  planId                     String
  billingCycle               BillingCycle?
  startDate                  DateTime
  expiryDate                 DateTime
  amount                     Float               @default(0)
  status                     SubscriptionStatus  @default(ACTIVE)
  autoRenew                  Boolean             @default(false)
  pausedAt                   DateTime?
  resumedAt                  DateTime?
  cancelledAt                DateTime?
  compassionateExtensionDays Int                 @default(0)
  compassionateReason        String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  billingCycleId             String?
  // ─── Upgrade / Downgrade tracking ───────────────────────────────────
  scheduledPlanId            String?             // for SCHEDULED_DOWNGRADE
  scheduledChangeDate        DateTime?           // when downgrade activates
  proRataCredit              Float?              // credit from old plan
  creditApplied              Float?              // credit used in upgrade
  upgradeFromSubId           String?             // previous subscription id
  payments                   Payment[]
  usage                      SubscriptionUsage[]
  planBillingCycle           PlanBillingCycle?   @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  plan                       Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  scheduledPlan              Plan?               @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  user                       User                @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model SubscriptionUsage {
  id              String       @id @default(uuid())
  subscriptionId  String
  serviceCategory String
  totalAllocated  Int
  usedCount       Int          @default(0)
  lockedCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_usage")
}

model SubscriptionUpgradeHistory {
  id            String   @id @default(uuid())
  userId        String
  oldPlanId     String
  newPlanId     String
  oldPlanName   String
  newPlanName   String
  oldPrice      Float
  newPrice      Float
  remainingDays Int
  creditApplied Float    @default(0)
  amountPaid    Float
  type          String   @default("UPGRADE") // UPGRADE | DOWNGRADE_SCHEDULED | RENEW
  upgradeDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  oldPlan       Plan     @relation("OldPlan", fields: [oldPlanId], references: [id])
  newPlan       Plan     @relation("NewPlan", fields: [newPlanId], references: [id])

  @@index([userId])
  @@map("subscription_upgrade_history")
}

model Payment {
  id                String         @id @default(uuid())
  userId            String
  bookingId         String?
  subscriptionId    String?
  amount            Float
  currency          String         @default("INR")
  paymentMethod     PaymentMethod?
  couponCode        String?
  discountAmount    Float          @default(0)
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  razorpaySignature String?
  status            PaymentStatus  @default(INITIATED)
  refundId          String?
  refundType        RefundType?
  refundReason      String?
  refundAmount      Float?
  refundedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  productOrderId    String?
  labOrderId        String?
  invoice           Invoice?
  booking           Booking?       @relation(fields: [bookingId], references: [id])
  labOrder          LabOrder?      @relation(fields: [labOrderId], references: [id])
  productOrder      ProductOrder?  @relation(fields: [productOrderId], references: [id])
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@map("payments")
}

model Invoice {
  id             String    @id @default(uuid())
  paymentId      String    @unique
  invoiceNumber  String    @unique
  invoiceDate    DateTime  @default(now())
  subtotal       Float
  gstRate        Float     @default(18)  // legacy — overall rate (kept for compat)
  gstAmount      Float
  totalAmount    Float
  lineItemGst    Json?     // { carePlan: 0, homePlan: 18, product: 18, fees: 18 } per-line breakdown
  pdfUrl         String?
  emailSentAt    DateTime?
  billingName    String?
  billingAddress String?
  billingGstin   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payment        Payment   @relation(fields: [paymentId], references: [id])

  @@map("invoices")
}

model SOSAlert {
  id              String     @id @default(uuid())
  userId          String
  cityId          String
  latitude        Float?
  longitude       Float?
  addressSnapshot String?
  responderId     String?
  status          SOSStatus  @default(ACTIVE)
  resolvedAt      DateTime?
  resolvedNotes   String?
  adminNotified   Boolean    @default(false)
  familyNotified  Boolean    @default(false)
  callLogNotes    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  city            City       @relation(fields: [cityId], references: [id])
  responder       Caregiver? @relation(fields: [responderId], references: [id])
  user            User       @relation(fields: [userId], references: [id])

  @@map("sos_alerts")
}

model NotificationLog {
  id            String              @id @default(uuid())
  channel       NotificationChannel
  recipientId   String?
  recipientType String              @default("user")
  templateId    String?
  subject       String?
  body          String?
  metadata      Json?
  cityId        String?
  isSent        Boolean             @default(false)
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  isRead        Boolean             @default(false)
  readAt        DateTime?
  city          City?               @relation(fields: [cityId], references: [id])

  @@map("notification_logs")
}

model NotificationTemplate {
  id           String              @id @default(uuid())
  name         String
  channel      NotificationChannel
  subject      String?
  bodyTemplate String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("notification_templates")
}

model LegalDocument {
  id          String         @id @default(uuid())
  type        String
  title       String
  content     String
  version     Int            @default(1)
  status      LegalDocStatus @default(DRAFT)
  publishedAt DateTime?
  editedBy    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("legal_documents")
}

model Product {
  id          String          @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  price       Float           @default(0)
  mrp         Float           @default(0)
  stock       Int             @default(0)
  isEnabled   Boolean         @default(true)
  categoryId  String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // --- Shiprocket specifications ---
  sku         String?
  weight      Float           @default(0.1)
  length      Float           @default(10)
  width       Float           @default(10)
  height      Float           @default(10)
  images      String[]        @default([])
  orders      ProductOrder[]
  category    Category        @relation(fields: [categoryId], references: [id])
  waitlist    WaitlistEntry[]

  @@map("products")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model SavedCard {
  id             String   @id @default(uuid())
  userId         String
  cardLast4      String
  cardBrand      String
  cardType       String   @default("CARD")
  cardholderName String?
  expiryMonth    String?
  expiryYear     String?
  upiId          String?
  razorpayToken  String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_cards")
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  userId    String
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@map("waitlist_entries")
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@index([adminId])
  @@map("audit_logs")
}

model UIConfig {
  id           String       @id @default(uuid())
  type         UIConfigType @default(CUSTOM)
  key          String       @unique
  label        String
  iconUrl      String?
  heroImageUrl String?
  bannerColor  String?
  ctaText      String?
  ctaRoute     String?
  configJson   Json?
  sortOrder    Int          @default(0)
  isVisible    Boolean      @default(true)
  version      Int          @default(1)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("ui_configs")
}

model InsuranceApplication {
  id                    String             @id @default(uuid())
  userId                String
  planName              String
  applicantName         String
  applicantAge          Int
  applicantGender       String
  preExistingConditions String[]
  documentsJson         Json?
  premium               Float              @default(0)
  status                InsuranceAppStatus @default(DRAFT)
  reviewNotes           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id])

  @@map("insurance_applications")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    @default("percentage")
  discountValue Float     @default(0)
  maxDiscount   Float?
  minOrderValue Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("coupons")
}

model MediaAsset {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int      @default(0)
  folder     String   @default("general")
  altText    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("media_assets")
}

model OtpLog {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("otp_logs")
}

model SupportTicket {
  id             String          @id @default(uuid())
  ticketCode     String          @unique
  userId         String?
  subject        String
  description    String?
  category       String?
  priority       String          @default("medium")
  status         String          @default("open")
  assignedTo     String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  senderId    String
  senderType  String        @default("user")
  message     String
  attachments Json?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model WellnessWaitlist {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  city      String?
  source    String   @default("wellness_page")
  createdAt DateTime @default(now())

  @@map("wellness_waitlist")
}

model ProductOrder {
  id                String    @id @default(uuid())
  orderCode         String    @unique
  userId            String
  productId         String?
  quantity          Int       @default(1)
  amount            Float
  shippingCharge    Float     @default(0)
  status            String    @default("PENDING")
  address           String?
  courierName       String?
  awbCode           String?
  trackingUrl       String?
  shippingStatus    String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // --- Shiprocket integration ---
  subtotal          Float     @default(0)
  tax               Float     @default(0)
  discount          Float     @default(0)
  shiprocketOrderId String?
  shipmentId        String?
  trackingStatus    String?
  trackingData      Json?
  items             Json?
  payments          Payment[]
  product           Product?  @relation(fields: [productId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@map("product_orders")
}

model LabOrder {
  id                 String           @id @default(uuid())
  userId             String
  bookingId          String?
  redcliffeBookingId String?          @unique
  clientRefId        String           @unique
  status             LabStatus        @default(PENDING)
  bookingType        LabBookingType
  patient            Json?
  additionalMembers  Json?
  address            Json?
  packages           Json?
  slot               Json?
  paymentDetails     Json?
  holdExpiresAt      DateTime?
  trackingLink       String?
  reportUrl          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  processedEvents    String[]         @default([])
  assignedStaff      Json?
  rescheduleReason   String?
  rescheduledAt      DateTime?
  rescheduledBy      String?
  rescheduledDate    DateTime?
  rescheduledTime    String?
  activityUpdates    ActivityUpdate[]
  booking            Booking?         @relation(fields: [bookingId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  payments           Payment[]

  @@map("lab_orders")
}

model ActivityUpdate {
  id            String    @id @default(uuid())
  labOrderId    String?   @map("lab_order_id")
  eventType     String
  serviceType   String
  staffName     String
  staffId       String
  staffPhone    String
  staffPhotoUrl String?
  eta           String?
  statusDetail  String?
  createdAt     DateTime  @default(now())
  labOrder      LabOrder? @relation(fields: [labOrderId], references: [id])

  @@map("activity_updates")
}

model ServiceCharge {
  id                     String   @id @default(uuid())
  serviceCategory        String   @unique @map("service_category")
  serviceFee             Float    @default(0) @map("service_fee")
  bookingFee             Float    @default(0) @map("booking_fee")
  platformFee            Float    @default(0) @map("platform_fee")
  convenienceFee         Float    @default(0) @map("convenience_fee")
  emergencyFee           Float    @default(0) @map("emergency_fee")
  visitFee               Float    @default(0) @map("visit_fee")
  nightCharge            Float    @default(0) @map("night_charge")
  surgeCharge            Float    @default(0) @map("surge_charge")
  taxPercentage          Float    @default(0) @map("tax_percentage")
  isSubscriptionEligible Boolean  @default(true) @map("is_subscription_eligible")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // ── Unified Pricing Console (read-only projection, Slice 1) ──
  // Mirrors Service.basePrice/pricingText for the merged admin view.
  // scope tells the UI whether this row is a single-service override
  // or a shared CATEGORY/SERVICE_TYPE default covering many services —
  // the actual cause of price drift between this table and Service.
  basePrice              Float?   @map("base_price")
  pricingText            String?  @map("pricing_text")
  scope                  String   @default("SERVICE") @map("scope") // SERVICE | CATEGORY | SERVICE_TYPE
  serviceId              String?  @map("service_id")

  @@map("service_charges")
}

model Banner {
  id          String    @id @default(uuid())
  imageUrl    String
  heading     String    @db.VarChar(60)
  subheading  String    @db.VarChar(80)
  ctaText     String?   @db.VarChar(30)
  ctaRoute    String?   @db.VarChar(100)
  category    String    @db.VarChar(20) @default("HOME")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, order])
  @@map("banners")
}

