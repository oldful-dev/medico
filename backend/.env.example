# ========================
# Core Configuration
# ========================
NODE_ENV=production
API_BASE_URL=https://api.ayuxacare.com
PORT=3000

# ========================
# Database
# ========================
DATABASE_URL=postgresql://user:password@localhost:5432/medico_db

# ========================
# Redis Cache
# ========================
REDIS_URL=redis://localhost:6379

# ========================
# Authentication & Security
# ========================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=7d
GITHUB_WEBHOOK_SECRET=your-webhook-secret-32-chars-minimum

# ========================
# Firebase Configuration
# ========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=your-cert-url

# ========================
# Google Cloud
# ========================
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_KEY_FILENAME=path/to/service-account.json

# ========================
# Payment Gateway (Razorpay)
# ========================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ========================
# Email Service (ZeptoMail)
# ========================
ZEPTOMAIL_ACCOUNT_ID=your-account-id
ZEPTOMAIL_API_KEY=your-api-key
ZEPTOMAIL_FROM_EMAIL=noreply@ayuxacare.com
ZEPTOMAIL_FROM_NAME=Ayuxa Care

# ========================
# SMS Service (Twilio/Interakt)
# ========================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone

INTERAKT_API_KEY=your-interakt-api-key
INTERAKT_BASE_URL=https://api.interakt.ai

# ========================
# File Storage (Google Cloud Storage)
# ========================
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcs-project-id

# ========================
# Logging & Monitoring
# ========================
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-if-using

# ========================
# CORS Configuration
# ========================
CORS_ORIGIN=https://ayuxacare.com,https://www.ayuxacare.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# Server Configuration
# ========================
MAX_JSON_SIZE=50mb
MAX_URL_ENCODED_SIZE=50mb

# ========================
# Admin Settings
# ========================
ADMIN_EMAIL=admin@ayuxacare.com
ADMIN_PASSWORD_HASH=your-hashed-password
